  "exclusions": [
    {
      "name": "ECID",
      "reason": "Broken in source property (custom code returns _satellite.getVar('ECID') \u2014 a recursive self-reference that always yields undefined). The Web SDK manages ECID itself; nothing in any payload referenced this element. Dropped rather than carried."
    },
    {
      "name": "XDM * (28 elements)",
      "reason": "Replaced by generated data-* payload builders (Finding 9 fix). See catalog/events-catalog.json \u2014 single source of truth, emitted by scripts/generate-blueprint.mjs from one template."
    },
    {
      "name": "XDM Article",
      "reason": "Orphan in source property \u2014 no rule references it. Its payload also references %Article Publish Date%, a data element that does not exist (copy-paste drift; 'Publish Date' is the real element). Not carried. Re-add via events-catalog.json if Article tracking is actually wanted."
    },
    {
      "name": "XDM Video Play",
      "reason": "Orphan in source property \u2014 no 'Video Play' rule exists, and its event1 mapping (event11) duplicates XDM Video Start. Not carried."
    },
    {
      "name": "XDM Sort By",
      "reason": "Never published: exists only as the payload of the never-published Sort By Tracking rule (both last modified May 2024, absent from every library and from the workbook's production build). Excluded with the rule - see events-catalog.json excludedRules. If sort-by tracking becomes real scope, define its mapping fresh in the catalog."
    }
  ],
