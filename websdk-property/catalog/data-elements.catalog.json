{
  "_purpose": "Dimension/utility data elements carried over 1:1 from the source property AboutAmazon-US (Launch Inspector export, build 2025-08-05). Settings are kept identical to the source; names follow the property owner's convention (below). Consumed by scripts/generate-blueprint.mjs.",
  "_naming": {
    "convention": "Adopted from the property owner during the 2026-07-29 entry pass, applied BEFORE any rule referenced an element (renames were free). Bare names = business values read from the data layer (ACDL computed state; UTM_* query params self-group by name). 'Plugin: ' prefix = visit mechanics computed by Common Web SDK Plugins. 'Core: ' prefix = browser-derived utilities via the Core extension (page info / custom code reading the browser, not the data layer). Business-meaning custom-code elements (Campaign, Internal Campaign, Internal Campaign Count, User Type) stay bare deliberately - the prefix describes mechanics, and these map to eVars analysts discuss by business name.",
    "renamedFromSource": {
      "Referrer": "Core: Referrer",
      "Timestamp": "Core: Timestamp",
      "Clean URL": "Core: Clean URL",
      "Page Query String": "Core: Page Query String",
      "Previous Page Name": "Plugin: Previous Page Name",
      "Repeat Vs New": "Plugin: Repeat Vs New",
      "Time Parting": "Plugin: Time Parting",
      "Time Since Last Visit": "Plugin: Time Since Last Visit",
      "Visit Duration": "Plugin: Visit Duration",
      "Visit Number": "Plugin: Visit Number",
      "Search Filter": "Search: Filter",
      "Search Result Click Name": "Search: Result Click Name",
      "Search Result PageType": "Search: Result Page Type",
      "Search Results": "Search: Results",
      "Search Term": "Search: Term",
      "Form Error Name": "Form: Error Name",
      "Form Location": "Form: Location",
      "Form Name": "Form: Name",
      "Video Name": "Video: Name",
      "Video Type": "Video: Type",
      "Map Button Name": "Map: Button Name",
      "Map Name": "Map: Name",
      "Article Content Type": "Article: Content Type",
      "Article Name": "Article: Name",
      "Consent Selected": "Consent: Selected",
      "Consent Click Count": "Consent: Click Count",
      "File Url": "File: URL",
      "LoginID": "Login ID",
      "ScrollInfo Depth": "Scroll Depth",
      "Page Name": "Page: Name",
      "Page Title": "Page: Title",
      "Page URL": "Page: URL",
      "Page View Count": "Page: View Count",
      "Site Section": "Site: Section",
      "Site Section2": "Site: Section 2",
      "Site Section3": "Site: Section 3",
      "Site Section4": "Site: Section 4",
      "Site Section5": "Site: Section 5",
      "File Name": "File: Name",
      "File Type": "File: Type",
      "Amazon Redirect Link": "Link: Amazon Redirect",
      "CTA Button Name": "Link: CTA Button",
      "Destination Link": "Link: Destination",
      "Link Name": "Link: Name",
      "Menu Link Name": "Link: Menu",
      "More Amazon News Text": "Link: More Amazon News Text",
      "Redirect Link Text": "Link: Redirect Text",
      "Related Tag Link": "Link: Related Tag",
      "Related Tag Link URL": "Link: Related Tag URL",
      "Stories Link Text": "Link: Stories Text",
      "Country": "Geo: Country",
      "Language": "Geo: Language",
      "Locale": "Geo: Locale"
    },
    "parityNote": "Old-vs-new beacon QA maps names through this ledger; settings are unchanged, so values are identical.",
    "featureGroups": "Business values that belong to a site feature are grouped 'Feature: value', dropping the redundant leading word (dropdown reads 'Search: Term', 'Page: Name'). Domain groups: Search, Form, Video, Map, Article, Consent, Page, Site, File, Link (click-target values), Geo (Country/Language/Locale). This DOMAIN axis (which feature uses the value) shares a colon with the SOURCE axis of Plugin:/Core: (which extension produced it) by the owner's choice (2026-07-29). Global dimensions were grouped too (owner confirmed, before any rule referenced them). Still bare, deliberately: cross-cutting singletons with no feature home (Domain, Category, Content Type, Tags, Hidden Tags, Publish Date, Scroll Depth, Social Interaction Info, Site Error, Login ID), the Campaign family (business-named custom code), and UTM_* (self-group by name)."
  },
  "_source": "aboutamazon.com.xlsx \u2014 DataElements sheet (108 elements; 72 carried, 28 XDM replaced by generated builders, remainder excluded with reasons below)",
